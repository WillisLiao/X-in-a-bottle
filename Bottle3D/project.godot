; Bottle, in 3D.

config_version=5

[application]

config/name="Bottle"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/quit_on_go_back=false
config/icon="res://icon.png"
boot_splash/show_image=false

[display]

window/size/viewport_width=1206
window/size/viewport_height=2622
window/stretch/mode="viewport"

; Enum, not a string. "portrait" parses as 0, which is landscape, and the
; exported plist said LandscapeLeft while the phone was held upright.
window/handheld/orientation=1

[rendering]

; Mobile, not Forward+. The phone ran hot enough to notice, and this app sits on
; a desk for twenty-five minutes at a time, so warmth is a product failure
; rather than a performance note. Mobile gives up volumetric fog and SDFGI: the
; fog was barely visible at the density it was tuned to, so that is a cheap
; trade for a cool phone.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

; Screen-space AA rather than MSAA. Far cheaper, and the scene is soft glows
; against black where MSAA earns very little.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
